# Importe este arquivo em Portainer > Stacks > Add stack > Git repository >
# Environment variables > Load variables from .env file. Preencha os valores vazios.
# A copia local .env.portainer e ignorada pelo Git e ja contem os valores disponiveis
# no .env desta maquina. Nunca publique essa copia no repositorio.
# Nao cadastre SEM_LOGIN: o Compose de producao o fixa em 0 e a API so abre
# quando Firebase ou Google Identity estiver configurado.

VOALLE_HOST=
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=
MARIA_USER=
MARIA_PASSWORD=
ACESSO_DB_DATABASE=DB_InstallationDashboard
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
ADMIN_EMAILS=
REDIS_PASSWORD=
SNAPSHOT_DIR_HOST=/srv/dashboard-instalacao/snapshot
WEB_BIND_HOST=0.0.0.0
WEB_PORT_HOST=3101
