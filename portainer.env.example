# Importe este arquivo em Portainer > Stacks > Add stack > Git repository >
# Environment variables > Load variables from .env file. Preencha os valores vazios.
# A copia local .env.portainer e ignorada pelo Git e ja contem os valores disponiveis
# no .env desta maquina. Nunca publique essa copia no repositorio.
# Nao cadastre SEM_LOGIN, PUBLICACAO, COOKIE_SECURE nem CONFIA_PROXY: o Compose de
# producao fixa os quatro (porta publicada direto, sem proxy - docs/PORTAINER.md).
# WEB_PORT_HOST é a porta da tela no host: http://<host>:3101.

VOALLE_HOST=
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=
MARIA_USER=
MARIA_PASSWORD=
ACESSO_DB_DATABASE=DB_InstallationDashboard
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
ADMIN_EMAILS=
# Token do Data Hub com acesso à publicação instalacao-senior (situação dos
# colaboradores). Vazio = ninguém é barrado pela Senior.
DATAHUB_TOKEN=
# observar = só mostra quem a Senior barraria; bloquear = barra de fato.
SENIOR_MODO=observar
# Fonte ao vivo (docs/DECISAO-AO-VIVO.md). AO_VIVO_PAGINAS=agendamento-field serve a
# Agendamento Field direto do SRD (mês a mês, com cache de 2 min no mês corrente e 1 h nos
# fechados); vazio = tudo pelo snapshot. AO_VIVO_SOMBRA=1 só compara em segundo plano
# (log e métricas). As duas abrem conexões próprias no SRD (analytics-ao-vivo).
AO_VIVO_PAGINAS=
AO_VIVO_SOMBRA=0
REDIS_PASSWORD=
SNAPSHOT_DIR_HOST=/srv/dashboard-instalacao/snapshot
WEB_PORT_HOST=3101
