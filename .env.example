# =============================================================================
# Analytics Platform — configuração de ambiente
# =============================================================================
# COPIE este arquivo para `.env` e preencha. O `.env` é ignorado pelo git.
#
#   cp .env.example .env
#
# NUNCA comite o `.env`, nem cole estes valores em chat/ticket/PR.
#
# Depois de preencher, valide a conectividade com:
#   npm run doctor
# =============================================================================


# -----------------------------------------------------------------------------
# dbVoalle — PostgreSQL do ERP Voalle (fonte principal: 15 das 24 queries)
# -----------------------------------------------------------------------------
# A plataforma é SOMENTE LEITURA. Use um usuário com permissão apenas de SELECT;
# o pool ainda força `default_transaction_read_only` como segunda barreira.
VOALLE_HOST=
VOALLE_PORT=5432
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
VOALLE_SCHEMA=erp
# Exige TLS na conexão (recomendado fora da rede interna): true | false
VOALLE_SSL=false
# Aceita certificado self-signed (só use se o servidor usar cert próprio)
VOALLE_SSL_REJECT_UNAUTHORIZED=true
# Tamanho do pool e timeouts (ms)
VOALLE_POOL_MAX=10
VOALLE_STATEMENT_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# dbMaria — MariaDB (3 queries do registry)
# -----------------------------------------------------------------------------
# Tabelas usadas em DB_Applicattion: Backlog_Installation, Backlog_Schedules,
# Installation_Teams.
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=DB_Applicattion
MARIA_USER=
MARIA_PASSWORD=
MARIA_SSL=false
MARIA_POOL_MAX=5
MARIA_STATEMENT_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# Redis — cache de queries (container no Portainer)
# -----------------------------------------------------------------------------
# Formato: redis://[:senha@]host:porta/db  ou  rediss:// para TLS
# Deixe VAZIO/comentado se não houver Redis: o cache cai para memória e o
# `doctor` pula a checagem em vez de reportar falha.
# REDIS_URL=redis://localhost:6379/0
# Prefixo das chaves — isole ambientes (dev/hml/prod) no mesmo Redis
REDIS_KEY_PREFIX=analytics:dev:


# -----------------------------------------------------------------------------
# Kafka — eventos CDC vindos do Debezium (container no Portainer)
# -----------------------------------------------------------------------------
# Lista separada por vírgula: host1:9092,host2:9092
KAFKA_BROKERS=
KAFKA_CLIENT_ID=analytics-platform
KAFKA_GROUP_ID=analytics-realtime
# Prefixo dos tópicos que o Debezium publica para o Postgres do Voalle.
# Ex.: com prefixo "voalle", a tabela contracts vira "voalle.public.contracts"
KAFKA_TOPIC_PREFIX=voalle
# SASL (deixe em branco se o broker for aberto na rede interna)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL=false


# -----------------------------------------------------------------------------
# Sebratel Data Hub — QUADRO FUNCIONAL (RH)
# -----------------------------------------------------------------------------
# Decisão de 05/08/2026: no Power BI de hoje, QUADRO FUNCIONAL vem do Google
# Sheets (GoogleSheets.Contents). Na plataforma nova, a mesma informação (dado de
# colaborador) viria do Data Hub interno — divergência deliberada de FONTE.
#
#   GET {DATAHUB_BASE_URL}/p/{DATAHUB_API_QUADRO_FUNCIONAL}?limit=&offset=
#
# O caminho é /p/{api}: a "api" é a publicação. O dataset por trás dela
# (db-senior-collaborators) vem no envelope da resposta, não na URL.
#
# AUTENTICAÇÃO: header X-Api-Token, NÃO ?token=. A API aceita as duas, mas token
# em query string vaza para log de acesso e histórico de proxy.
#
# ATENÇÃO — a troca de fonte está BLOQUEADA, não implementada. Sondando a API
# (npm run probe:datahub) apareceu que supervisor_name, coordinator_name e
# manager_name vêm null em 100% das 2448 linhas, e GESTOR é a ÚNICA coluna que a
# mesclagem em PROTOCOLOS PRODUTIVIDADE expande da planilha. Sem dado de gestor o
# connector não é escrito: ver docs/ACHADOS.md #17 e PERGUNTAS-NEGOCIO.md #3.
#
# O token NÃO vai na URL commitada — só aqui, via variável de ambiente.
DATAHUB_TOKEN=
DATAHUB_BASE_URL=https://data-hub.sebratel.net.br/api/public/v1
DATAHUB_DATASET_QUADRO_FUNCIONAL=clientes-ativos-na-base
DATAHUB_DATASET_QUADRO_FUNCIONAL=clientes-ativos-na-base
DATAHUB_API_QUADRO_FUNCIONAL=dash-instalacao


# -----------------------------------------------------------------------------
# Google Sheets — 3 planilhas (QUADRO FUNCIONAL voltou para cá; ver ACHADOS #17)
# -----------------------------------------------------------------------------
# ESTADO EM 06/08/2026: resolvido. Basta a SERVICE ACCOUNT logo abaixo — as 3
# planilhas estão compartilhadas como Leitor com o e-mail dela, e as 3 queries de
# planilha rodam ponta a ponta. Todo o resto desta seção (chave de API, OAuth) é
# alternativa e diagnóstico: NÃO preencha nada disso para trabalhar no projeto.
#
# A credencial é uma service account do Google Cloud, e o passo que não é código é
# compartilhar cada planilha com o e-mail dela (algo@projeto.iam.gserviceaccount.com)
# com permissão de **LEITOR** — o que também satisfaz a regra read-only do projeto.
# Atenção ao trocar de conta de serviço: a permissão é da IDENTIDADE, então o que
# foi compartilhado com a antiga não vale para a nova. O caminho completo, e como a
# confusão de três credenciais custou tempo, está em docs/DECISAO-CAMADA-M.md
# (Anexo B) e docs/ACHADOS.md #23.
#
# Caminho para o arquivo JSON da chave. Guarde-o FORA do repositório.
GOOGLE_APPLICATION_CREDENTIALS=
#
# Chave de API do Google — OPCIONAL, e só para diagnóstico.
# Ela NÃO substitui a service account, e a diferença não é de configuração:
# chave de API identifica o PROJETO, não uma PESSOA. Ela não carrega permissão
# nenhuma, então só alcança planilha marcada como "qualquer pessoa com o link".
# As 3 planilhas da base são privadas (medido: HTTP 401 sem credencial), e
# QUADRO FUNCIONAL tem CPF e RG — torná-la pública para a chave funcionar seria
# trocar um bloqueio por um vazamento.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
# Preencha só se quiser que `npm run probe:gsheets` prove isso na sua planilha.
#
# Só o 403 vale como medição. Chave revogada ou com typo dá 400 "API Key not
# found", e aí o Google recusou a CHAVE sem nunca olhar o documento — não conclua
# nada sobre permissão a partir disso (o probe passou a dizer isso explicitamente).
#
# Só o 403 vale como medição. Chave revogada ou com typo dá 400 "API Key not
# found", e aí o Google recusou a CHAVE sem nunca olhar o documento — não conclua
# nada sobre permissão a partir disso (o probe passou a dizer isso explicitamente).
GSHEETS_API_KEY=
#
# --- OAuth de usuário: o OUTRO caminho de acesso -----------------------------
# NÃO É NECESSÁRIO HOJE — a service account acima resolve, e este caminho nunca
# chegou a ser usado. Fica implementado porque é a saída de quando não se pode
# compartilhar a planilha com um robô, e porque OAuth amarra a leitura a uma conta
# PESSOAL: o refresh token morre se a senha mudar, se a pessoa sair, ou em 7 dias
# se a tela de consentimento estiver em modo "Teste". Para produção, service
# account. Deixe as quatro variáveis desta subseção vazias.
#
# Use quando a planilha NÃO está compartilhada com a conta de serviço, mas está
# com uma pessoa. A plataforma passa a agir como essa pessoa.
#
# CLIENT ID E SECRET NÃO SÃO ACESSO. Eles identificam o *aplicativo*; sozinhos não
# abrem planilha nenhuma. O acesso vem do consentimento de uma conta Google, uma
# vez, no navegador — e é o acesso DESSA CONTA que a plataforma ganha. Portanto:
# na tela de consentimento, escolha uma conta que enxergue as 3 planilhas.
#
#   1. preencha as três variáveis abaixo
#   2. rode `npm run auth:google` (abre o navegador, grava o refresh token)
#   3. `npm run probe:gsheets` já usa essa identidade — e diz qual está usando
#
# O cliente OAuth precisa ser do tipo "Aplicativo para desktop"; do tipo "Web",
# é preciso cadastrar http://localhost:8765/oauth2callback como URI de
# redirecionamento autorizado (o comando imprime o URI exato ao falhar).
#
# AS DUAS SÃO OPCIONAIS se o arquivo apontado em GOOGLE_OAUTH_TOKEN_FILE já as
# contiver: é o caso do JSON `"type": "authorized_user"` que o
# `gcloud auth application-default login` grava — ele traz client id, secret e
# refresh token juntos, e aí o passo 2 (`auth:google`) é dispensável.
# ATENÇÃO: esse arquivo NÃO registra escopo, e o consentimento do gcloud concede
# `cloud-platform` — permissão de GCP, que não é permissão de documento. Ele pode
# autenticar e ainda ser recusado ao ler planilha; o erro diz exatamente isso.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# O refresh token tem DOIS jeitos de chegar até o código — use um:
#
#   a) direto aqui embaixo, sem arquivo nenhum (mesma convenção de DATAHUB_TOKEN,
#      VOALLE_PASSWORD etc.) — cole o que alguém que já autorizou te passar, ou
#      o "refresh_token" do arquivo que `npm run auth:google` gera;
GOOGLE_OAUTH_REFRESH_TOKEN=
#
#   b) num arquivo à parte, se preferir não deixar no .env — aponte aqui e rode
#      `npm run auth:google`, que grava nesse caminho. GOOGLE_OAUTH_REFRESH_TOKEN
#      acima, se preenchido, tem precedência sobre este arquivo.
# Onde quer que grave, é credencial de LONGA DURAÇÃO — tão sensível quanto a chave
# da service account. Se usar arquivo, mantenha-o FORA de qualquer repositório
# git: o `Desktop` inteiro é um repo com remote real e sem .gitignore.
GOOGLE_OAUTH_TOKEN_FILE=
#
# Porta do loopback do auth:google, se a 8765 estiver ocupada: GOOGLE_OAUTH_PORT=8766
#
# Chave de API do Google — OPCIONAL, e só para diagnóstico.
# Ela NÃO substitui a service account, e a diferença não é de configuração:
# chave de API identifica o PROJETO, não uma PESSOA. Ela não carrega permissão
# nenhuma, então só alcança planilha marcada como "qualquer pessoa com o link".
# As 3 planilhas da base são privadas (medido: HTTP 401 sem credencial), e
# QUADRO FUNCIONAL tem CPF e RG — torná-la pública para a chave funcionar seria
# trocar um bloqueio por um vazamento.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
# Preencha só se quiser que `npm run probe:gsheets` prove isso na sua planilha.
#
# Só o 403 vale como medição. Chave revogada ou com typo dá 400 "API Key not
# found", e aí o Google recusou a CHAVE sem nunca olhar o documento — não conclua
# nada sobre permissão a partir disso (o probe passou a dizer isso explicitamente).
#
# Só o 403 vale como medição. Chave revogada ou com typo dá 400 "API Key not
# found", e aí o Google recusou a CHAVE sem nunca olhar o documento — não conclua
# nada sobre permissão a partir disso (o probe passou a dizer isso explicitamente).
#
# Só o 403 vale como medição. Chave revogada ou com typo dá 400 "API Key not
# found", e aí o Google recusou a CHAVE sem nunca olhar o documento — não conclua
# nada sobre permissão a partir disso (o probe passou a dizer isso explicitamente).
GSHEETS_API_KEY=
#
# --- OAuth de usuário: o OUTRO caminho de acesso -----------------------------
# NÃO É NECESSÁRIO HOJE — a service account acima resolve, e este caminho nunca
# chegou a ser usado. Fica implementado porque é a saída de quando não se pode
# compartilhar a planilha com um robô, e porque OAuth amarra a leitura a uma conta
# PESSOAL: o refresh token morre se a senha mudar, se a pessoa sair, ou em 7 dias
# se a tela de consentimento estiver em modo "Teste". Para produção, service
# account. Deixe as quatro variáveis desta subseção vazias.
#
# Use quando a planilha NÃO está compartilhada com a conta de serviço, mas está
# com uma pessoa. A plataforma passa a agir como essa pessoa.
#
# CLIENT ID E SECRET NÃO SÃO ACESSO. Eles identificam o *aplicativo*; sozinhos não
# abrem planilha nenhuma. O acesso vem do consentimento de uma conta Google, uma
# vez, no navegador — e é o acesso DESSA CONTA que a plataforma ganha. Portanto:
# na tela de consentimento, escolha uma conta que enxergue as 3 planilhas.
#
#   1. preencha as três variáveis abaixo
#   2. rode `npm run auth:google` (abre o navegador, grava o refresh token)
#   3. `npm run probe:gsheets` já usa essa identidade — e diz qual está usando
#
# O cliente OAuth precisa ser do tipo "Aplicativo para desktop"; do tipo "Web",
# é preciso cadastrar http://localhost:8765/oauth2callback como URI de
# redirecionamento autorizado (o comando imprime o URI exato ao falhar).
#
# AS DUAS SÃO OPCIONAIS se o arquivo apontado em GOOGLE_OAUTH_TOKEN_FILE já as
# contiver: é o caso do JSON `"type": "authorized_user"` que o
# `gcloud auth application-default login` grava — ele traz client id, secret e
# refresh token juntos, e aí o passo 2 (`auth:google`) é dispensável.
# ATENÇÃO: esse arquivo NÃO registra escopo, e o consentimento do gcloud concede
# `cloud-platform` — permissão de GCP, que não é permissão de documento. Ele pode
# autenticar e ainda ser recusado ao ler planilha; o erro diz exatamente isso.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# O refresh token tem DOIS jeitos de chegar até o código — use um:
#
#   a) direto aqui embaixo, sem arquivo nenhum (mesma convenção de DATAHUB_TOKEN,
#      VOALLE_PASSWORD etc.) — cole o que alguém que já autorizou te passar, ou
#      o "refresh_token" do arquivo que `npm run auth:google` gera;
GOOGLE_OAUTH_REFRESH_TOKEN=
#
#   b) num arquivo à parte, se preferir não deixar no .env — aponte aqui e rode
#      `npm run auth:google`, que grava nesse caminho. GOOGLE_OAUTH_REFRESH_TOKEN
#      acima, se preenchido, tem precedência sobre este arquivo.
# Onde quer que grave, é credencial de LONGA DURAÇÃO — tão sensível quanto a chave
# da service account. Se usar arquivo, mantenha-o FORA de qualquer repositório
# git: o `Desktop` inteiro é um repo com remote real e sem .gitignore.
GOOGLE_OAUTH_TOKEN_FILE=
#
# Porta do loopback do auth:google, se a 8765 estiver ocupada: GOOGLE_OAUTH_PORT=8766
#
# QUADRO FUNCIONAL — 9 medidas dependem dela via PROTOCOLOS PRODUTIVIDADE.
GSHEETS_QUADRO_FUNCIONAL_ID=13aqmagy60DF_KJ5I4jucJD67qlJNOzzE1g1-sdU0Gjo
# #APURAÇÃO PREMIAÇÃO — 1 medida cita ([Instalações Apuradas]).
GSHEETS_APURACAO_PREMIACAO_ID=1UUyahgV-Z6WJGT1U7BAQjPg1TfLxPZoKnwJoQSAcYYM
# CAPACIDADE EQUIPE — nenhuma medida cita esta tabela hoje.
GSHEETS_CAPACIDADE_EQUIPE_ID=1hocqNXymH5U9NouhhcIQNOjujacdltwvS4lLA_hFGcI


# -----------------------------------------------------------------------------
# Power BI — o relatório contra o qual a paridade é medida
# -----------------------------------------------------------------------------
#
# QUAL RELATÓRIO. É o `INST - Relatório Instalação`. **NÃO é o
# `INST - Relatório Instalação Gerencial`** — são dois relatórios, e apontar o
# token para o errado não dá erro nenhum: dá números plausíveis e diferentes, que
# entram em specs/_catalog/paridade-janela.yaml como se fossem gabarito.
# (Erick, 27/08/2026. As três tabelas em `bloqueadas` naquele arquivo falham todas
# com "definições diferentes" — que é a cara desse engano.)
#
# NADA AQUI É SEGREDO. O id do relatório e o do tenant estão na própria URL que o
# navegador mostra ao abrir o relatório. O segredo é o token, e ele NÃO entra no
# repositório: vai para ~/.secrets/powerbi-token.json (POWERBI_TOKEN_FILE muda o
# caminho). Motivo: o `Desktop` inteiro é um repo git com remoto configurado.
#
# Sem estas duas variáveis, `npm run powerbi` exige --url= a cada chamada
# (tools/powerbi/src/index.ts:180-183) — e, pior, o repositório não guarda registro
# de contra qual relatório cada número de paridade foi medido.
#
# Cole a URL inteira do relatório; o `reportId` e o `ctid` saem dela.
POWERBI_URL=
#
# Ou os dois separados. Estes SAO os valores certos, medidos em 25/08/2026 —
# o tenant saiu do proprio arquivo de token.
POWERBI_REPORT_ID=f12d1205-62d7-4bc3-b300-ea7268076dd4
POWERBI_TENANT_ID=Sebratel.onmicrosoft.com
#
# O dataset e resolvido a partir do relatorio; fica so como registro:
# POWERBI_DATASET_ID=39382a2c-a349-4cce-8c4a-9703c9fa4364
#
# ⚠️ O id do `... Gerencial` e 5576f259-5fe4-41ec-9b16-c1248191d46d. Se voce
#    encontrar esse id em algum lugar, NAO e o nosso relatorio.
#
# Onde guardar o token. Padrão: ~/.secrets/powerbi-token.json
POWERBI_TOKEN_FILE=
#
# Client id do Azure AD, se o tenant bloquear o do Azure CLI (tools/powerbi/src/auth.ts).
# AZURE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Plataforma
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Porta da API (apps/api/src/index.ts). O código, sem PORT definido, já cai em
# 3100 — é o valor real, não 3000. Um .env de produção copiado sem trocar isto e um
# Nginx apontando para 3100 dá 502 sem motivo aparente (docs/DEPLOY.md §3.5).
PORT=3100

# -----------------------------------------------------------------------------
# Login (SSO do HUBBI = Google Identity Services restrito ao domínio corporativo
# — investigado no código-fonte do HUBBI: não existe provedor nem sessão
# compartilhados entre apps do HUBBI, cada um valida a mesma conta Google e
# emite sua própria sessão. Ver apps/api/src/auth-google.ts e identidade.ts.)
# -----------------------------------------------------------------------------
# Sem isto, /auth/google recusa todo token (falha fechada) e ninguém loga.
GOOGLE_CLIENT_ID=
DOMINIO_CORPORATIVO=sebratel.com.br
# Por quanto tempo uma sessão criada em /auth/google vale, em horas.
SESSAO_TTL_HORAS=12
# MESMO VALOR de GOOGLE_CLIENT_ID, repetido com o prefixo VITE_ — o Vite só
# expõe ao navegador variável que comece com esse prefixo, e apps/web/
# vite.config.ts lê exatamente esta chave (via `define`) para injetar no
# bundle. Não é engano: são duas variáveis por regra do Vite, não uma
# duplicata por descuido.
VITE_GOOGLE_CLIENT_ID=

# Segredo que libera POST /auth/interno — a única forma de `npm run tela`
# (que dirige um navegador de VERDADE contra a API, sem conta do Google)
# logar. Vazio desliga a rota inteira (falha fechada); `tools/tela` também
# lê esta chave para se autenticar sozinho. Gere qualquer string aleatória
# só para esta máquina — não é senha de ninguém, é um segredo entre este
# processo e a própria ferramenta de teste.
TOKEN_INTERNO=
