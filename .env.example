# Dashboard de Instalação — único `.env` da stack.
# Copie para `.env`, preencha os valores e nunca versione esse arquivo.
# Portas, pools, memória, workers e cadência têm valores fixados pelo código ou
# pelo compose de produção: não replique defaults aqui.

# Voalle (PostgreSQL, somente leitura)
VOALLE_HOST=
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=

# MariaDB da instalação (leitura dos dados e permissões da tela)
MARIA_HOST=
MARIA_DATABASE=
MARIA_USER=
MARIA_PASSWORD=

# Login Firebase — os quatro `VITE_` são públicos e entram no build da tela.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Administradores emergenciais, separados por vírgula. As demais permissões
# ficam no MariaDB e são gerenciadas pela própria tela.
ADMIN_EMAILS=

# Redis externo da Sebratel — opcional. Sem ele, o cache fica em memória.
# Inclua usuário e senha na URL. Não existem REDIS_PASSWORD nem REDIS_KEY_PREFIX.
# REDIS_URL=rediss://usuario:senha@redis.sebratel.net.br:6379/0

# Produção atrás do proxy do Misael: use `1` nos dois somente quando ele
# reescrever X-Real-IP e encerrar o TLS. Para execução local, mantenha `0`.
CONFIA_PROXY=0
COOKIE_SECURE=0
