# Dashboard de Instalação — ambiente local da stack.
# Copie para `.env`, preencha os valores e nunca versione esse arquivo. No
# Portainer, cadastre estas mesmas chaves nas variáveis da stack: não envie `.env`.
# Portas, pools, memória, workers e cadência têm valores fixados pelo código ou
# pelo compose de produção: não replique defaults aqui.

# Voalle (PostgreSQL, somente leitura). TLS é obrigatório. Os bancos corporativos
# usam certificado autoassinado, então a cadeia não é validada até a CA ser instalada.
VOALLE_HOST=
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
VOALLE_SSL=1
VOALLE_SSL_REJECT_UNAUTHORIZED=0

# MariaDB: a mesma conta atende o refresh e as tabelas de acesso da API.
# Ela precisa de leitura nas fontes e dos grants de acesso em DB_InstallationDashboard.
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=
MARIA_USER=
MARIA_PASSWORD=
MARIA_SSL=1
MARIA_SSL_REJECT_UNAUTHORIZED=0

# Banco das tabelas de acesso da API (mesma conta MARIA_*).
ACESSO_DB_DATABASE=DB_InstallationDashboard

# Login Firebase — os quatro `VITE_` são públicos e entram no build da tela.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Administradores emergenciais, separados por vírgula. As demais permissões
# ficam no MariaDB e são gerenciadas pela própria tela.
ADMIN_EMAILS=

# Redis exclusivo desta stack. Gere uma senha hexadecimal com `openssl rand -hex 24`.
REDIS_PASSWORD=

# Sem proxy na frente, os dois ficam em `0`: confiar em X-Real-IP forjável enfraquece o
# rate limit, e COOKIE_SECURE=1 sem HTTPS impede o login. Na stack de produção quem
# decide é o compose (PUBLICACAO=direta fixa os dois em 0); estas linhas valem para o
# `npm start` local.
CONFIA_PROXY=0
COOKIE_SECURE=0

# Container web (frontend React). A API fica privada na rede Docker.
WEB_PORT_HOST=3101
