# Dashboard de Instalação — ambiente local da stack.
# Copie para `.env`, preencha os valores e nunca versione esse arquivo. No
# Portainer, cadastre estas mesmas chaves nas variáveis da stack: não envie `.env`.
# Portas, pools, memória, workers e cadência têm valores fixados pelo código ou
# pelo compose de produção: não replique defaults aqui.

# Voalle (PostgreSQL, somente leitura). Em produção, TLS e validação do
# certificado são obrigatórios; o overlay docker-compose.local.yml os desliga
# só para desenvolvimento local explícito.
VOALLE_HOST=
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
VOALLE_SSL=1
VOALLE_SSL_REJECT_UNAUTHORIZED=1

# MariaDB: a mesma conta atende o refresh e as tabelas de acesso da API.
# Ela precisa de leitura nas fontes e dos grants de acesso em DB_InstallationDashboard.
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=
MARIA_USER=
MARIA_PASSWORD=
MARIA_SSL=1
MARIA_SSL_REJECT_UNAUTHORIZED=1

# Banco das tabelas de acesso da API (mesma conta MARIA_*).
ACESSO_DB_DATABASE=DB_InstallationDashboard

# Login Firebase — os quatro `VITE_` são públicos e entram no build da tela.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Administradores emergenciais, separados por vírgula. As demais permissões
# ficam no MariaDB e são gerenciadas pela própria tela.
ADMIN_EMAILS=

# Redis exclusivo desta stack. Gere uma senha hexadecimal com `openssl rand -hex 24`.
REDIS_PASSWORD=

# Produção: use `1` nos dois somente quando o proxy do Misael receber HTTPS, encerrar
# TLS e SOBRESCREVER X-Real-IP antes de encaminhar à API. Sem essas garantias, mantenha
# `0`: confiar em X-Real-IP forjável enfraquece o rate limit; COOKIE_SECURE=1 sem HTTPS
# impede o login. O overlay local substitui os dois para 0.
CONFIA_PROXY=1
COOKIE_SECURE=1

# Container web (frontend React). A API fica privada na rede Docker; o proxy
# HTTPS externo aponta para esta porta.
WEB_BIND_HOST=0.0.0.0
WEB_PORT_HOST=3101
