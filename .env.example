# Dashboard de Instalação — ambiente da stack
# Copie para `.env`, preencha os valores e nunca versione esse arquivo.
#
# Produção:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# O compose fixa `NODE_ENV`, `PORT`, memória e cadência de refresh. Não os
# declare aqui: esta é somente a configuração que vem do ambiente.

# Banco de origem Voalle (PostgreSQL, somente leitura)
VOALLE_HOST=
VOALLE_PORT=5432
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
VOALLE_SCHEMA=erp
VOALLE_SSL=false
VOALLE_SSL_REJECT_UNAUTHORIZED=true
VOALLE_POOL_MAX=10
VOALLE_STATEMENT_TIMEOUT_MS=30000

# Banco de apoio da instalação (MariaDB, somente leitura)
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=DB_Applicattion
MARIA_USER=
MARIA_PASSWORD=
MARIA_SSL=false
MARIA_POOL_MAX=5
MARIA_STATEMENT_TIMEOUT_MS=30000

# Login Firebase — os quatro valores `VITE_` entram no build do frontend.
# A `apiKey` do Firebase é pública; a segurança está no domínio autorizado e na
# validação do token pela API.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
DOMINIO_CORPORATIVO=sebratel.com.br

# Acesso emergencial às abas (e-mails separados por vírgula).
# As permissões normais são gerenciadas no banco pela própria tela.
ADMIN_EMAILS=
DEV_EMAILS=

# Redis externo da Sebratel — opcional. Sem ele, a API mantém o cache em memória.
# Inclua usuário e senha na própria URL; `REDIS_PASSWORD` e `REDIS_KEY_PREFIX`
# não são usados pela stack atual.
# REDIS_URL=rediss://usuario:senha@redis.sebratel.net.br:6379/0

# Publicação da stack. O proxy do Misael aponta para esta porta.
SNAPSHOT_DIR_HOST=./snapshot
API_BIND_HOST=127.0.0.1
API_PORT_HOST=3100

# Só use `1` quando o proxy reverso reescrever `X-Real-IP` e terminar TLS.
# No Portainer atrás do proxy do Misael, os dois normalmente são `1`.
CONFIA_PROXY=0
COOKIE_SECURE=0
