# =============================================================================
# Analytics Platform — configuração de ambiente
# =============================================================================
# COPIE este arquivo para `.env` e preencha. O `.env` é ignorado pelo git.
#
#   cp .env.example .env
#
# NUNCA comite o `.env`, nem cole estes valores em chat/ticket/PR.
#
# Depois de preencher, valide a conectividade com:
#   npm run doctor
# =============================================================================


# -----------------------------------------------------------------------------
# dbVoalle — PostgreSQL do ERP Voalle (fonte principal: 15 das 24 queries)
# -----------------------------------------------------------------------------
# A plataforma é SOMENTE LEITURA. Use um usuário com permissão apenas de SELECT;
# o pool ainda força `default_transaction_read_only` como segunda barreira.
VOALLE_HOST=
VOALLE_PORT=5432
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
VOALLE_SCHEMA=erp
# Exige TLS na conexão (recomendado fora da rede interna): true | false
VOALLE_SSL=false
# Aceita certificado self-signed (só use se o servidor usar cert próprio)
VOALLE_SSL_REJECT_UNAUTHORIZED=true
# Tamanho do pool e timeouts (ms)
VOALLE_POOL_MAX=10
VOALLE_STATEMENT_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# dbMaria — MariaDB (3 queries do registry)
# -----------------------------------------------------------------------------
# Tabelas usadas em DB_Applicattion: Backlog_Installation, Backlog_Schedules,
# Installation_Teams.
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=DB_Applicattion
MARIA_USER=
MARIA_PASSWORD=
MARIA_SSL=false
MARIA_POOL_MAX=5
MARIA_STATEMENT_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# Redis — cache de queries (container no Portainer)
# -----------------------------------------------------------------------------
# Formato: redis://[:senha@]host:porta/db  ou  rediss:// para TLS
# Deixe VAZIO/comentado se não houver Redis: o cache cai para memória e o
# `doctor` pula a checagem em vez de reportar falha.
# REDIS_URL=redis://localhost:6379/0
# Prefixo das chaves — isole ambientes (dev/hml/prod) no mesmo Redis
REDIS_KEY_PREFIX=analytics:dev:


# -----------------------------------------------------------------------------
# Kafka — eventos CDC vindos do Debezium (container no Portainer)
# -----------------------------------------------------------------------------
# Lista separada por vírgula: host1:9092,host2:9092
KAFKA_BROKERS=
KAFKA_CLIENT_ID=analytics-platform
KAFKA_GROUP_ID=analytics-realtime
# Prefixo dos tópicos que o Debezium publica para o Postgres do Voalle.
# Ex.: com prefixo "voalle", a tabela contracts vira "voalle.public.contracts"
KAFKA_TOPIC_PREFIX=voalle
# SASL (deixe em branco se o broker for aberto na rede interna)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL=false


# -----------------------------------------------------------------------------
# Sebratel Data Hub — QUADRO FUNCIONAL (RH)
# -----------------------------------------------------------------------------
# Decisão de 05/08/2026: no Power BI de hoje, QUADRO FUNCIONAL vem do Google
# Sheets (GoogleSheets.Contents). Na plataforma nova, a mesma informação (dado de
# colaborador) viria do Data Hub interno — divergência deliberada de FONTE.
#
#   GET {DATAHUB_BASE_URL}/p/{DATAHUB_API_QUADRO_FUNCIONAL}?limit=&offset=
#
# O caminho é /p/{api}: a "api" é a publicação. O dataset por trás dela
# (db-senior-collaborators) vem no envelope da resposta, não na URL.
#
# AUTENTICAÇÃO: header X-Api-Token, NÃO ?token=. A API aceita as duas, mas token
# em query string vaza para log de acesso e histórico de proxy.
#
# ATENÇÃO — a troca de fonte está BLOQUEADA, não implementada. Sondando a API
# (npm run probe:datahub) apareceu que supervisor_name, coordinator_name e
# manager_name vêm null em 100% das 2448 linhas, e GESTOR é a ÚNICA coluna que a
# mesclagem em PROTOCOLOS PRODUTIVIDADE expande da planilha. Sem dado de gestor o
# connector não é escrito: ver docs/ACHADOS.md #17 e PERGUNTAS-NEGOCIO.md #3.
#
# O token NÃO vai na URL commitada — só aqui, via variável de ambiente.
DATAHUB_TOKEN=
DATAHUB_BASE_URL=https://data-hub.sebratel.net.br/api/public/v1
DATAHUB_API_QUADRO_FUNCIONAL=dash-instalacao


# -----------------------------------------------------------------------------
# Google Sheets — 2 planilhas (QUADRO FUNCIONAL saiu daqui, ver acima)
# -----------------------------------------------------------------------------
# NÃO existe connector para baixar: é código nosso (a escrever) + uma credencial.
# A credencial é uma SERVICE ACCOUNT do Google Cloud, e o passo que não é código
# é compartilhar cada planilha com o e-mail dela (algo@projeto.iam.gserviceaccount.com)
# com permissão de **LEITOR** — o que também satisfaz a regra read-only do projeto.
# O caminho completo está em docs/DECISAO-CAMADA-M.md.
#
# Baixa urgência agora: nenhuma das duas é a que bloqueava a 2b.8.
#
# Caminho para o arquivo JSON da chave. Guarde-o FORA do repositório.
GOOGLE_APPLICATION_CREDENTIALS=
#
# Chave de API do Google — OPCIONAL, e só para diagnóstico.
# Ela NÃO substitui a service account, e a diferença não é de configuração:
# chave de API identifica o PROJETO, não uma PESSOA. Ela não carrega permissão
# nenhuma, então só alcança planilha marcada como "qualquer pessoa com o link".
# As 3 planilhas da base são privadas (medido: HTTP 401 sem credencial), e
# QUADRO FUNCIONAL tem CPF e RG — torná-la pública para a chave funcionar seria
# trocar um bloqueio por um vazamento.
#
# MEDIDO em 06/08/2026 com uma chave real, restrita à API do Sheets no console:
# as 3 responderam HTTP 403 "caller does not have permission". A chave é válida
# (o Google respondeu sobre PERMISSÃO, não sobre autenticação) — o que falta não
# é configuração dela. Restringir a chave "à API do Sheets" autoriza CHAMAR a
# API, não ler documento privado; o console junta as duas coisas na mesma tela.
# Preencha só se quiser que `npm run probe:gsheets` prove isso na sua planilha.
GSHEETS_API_KEY=
#
# --- OAuth de usuário: o OUTRO caminho de acesso -----------------------------
# Use quando a planilha NÃO está compartilhada com a conta de serviço, mas está
# com uma pessoa. A plataforma passa a agir como essa pessoa.
#
# CLIENT ID E SECRET NÃO SÃO ACESSO. Eles identificam o *aplicativo*; sozinhos não
# abrem planilha nenhuma. O acesso vem do consentimento de uma conta Google, uma
# vez, no navegador — e é o acesso DESSA CONTA que a plataforma ganha. Portanto:
# na tela de consentimento, escolha uma conta que enxergue as 3 planilhas.
#
#   1. preencha as três variáveis abaixo
#   2. rode `npm run auth:google` (abre o navegador, grava o refresh token)
#   3. `npm run probe:gsheets` já usa essa identidade — e diz qual está usando
#
# O cliente OAuth precisa ser do tipo "Aplicativo para desktop"; do tipo "Web",
# é preciso cadastrar http://localhost:8765/oauth2callback como URI de
# redirecionamento autorizado (o comando imprime o URI exato ao falhar).
#
# AS DUAS SÃO OPCIONAIS se o arquivo apontado em GOOGLE_OAUTH_TOKEN_FILE já as
# contiver: é o caso do JSON `"type": "authorized_user"` que o
# `gcloud auth application-default login` grava — ele traz client id, secret e
# refresh token juntos, e aí o passo 2 (`auth:google`) é dispensável.
# ATENÇÃO: esse arquivo NÃO registra escopo, e o consentimento do gcloud concede
# `cloud-platform` — permissão de GCP, que não é permissão de documento. Ele pode
# autenticar e ainda ser recusado ao ler planilha; o erro diz exatamente isso.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# Onde gravar o refresh token — credencial de LONGA DURAÇÃO, tão sensível quanto a
# chave da service account. FORA de qualquer repositório git: o `Desktop` inteiro é
# um repo com remote real e sem .gitignore. O comando se recusa a gravar dentro de
# um repo (procura `.git` subindo do caminho), mas escolha certo de qualquer forma.
GOOGLE_OAUTH_TOKEN_FILE=
#
# Porta do loopback, se a 8765 estiver ocupada: GOOGLE_OAUTH_PORT=8766
#
# QUADRO FUNCIONAL — 9 medidas dependem dela via PROTOCOLOS PRODUTIVIDADE.
GSHEETS_QUADRO_FUNCIONAL_ID=13aqmagy60DF_KJ5I4jucJD67qlJNOzzE1g1-sdU0Gjo
# #APURAÇÃO PREMIAÇÃO — 1 medida cita ([Instalações Apuradas]).
GSHEETS_APURACAO_PREMIACAO_ID=1UUyahgV-Z6WJGT1U7BAQjPg1TfLxPZoKnwJoQSAcYYM
# CAPACIDADE EQUIPE — nenhuma medida cita esta tabela hoje.
GSHEETS_CAPACIDADE_EQUIPE_ID=1hocqNXymH5U9NouhhcIQNOjujacdltwvS4lLA_hFGcI


# -----------------------------------------------------------------------------
# Plataforma
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Porta do Analytics Core (Fastify) — usada a partir da Fase 3
PORT=3000
