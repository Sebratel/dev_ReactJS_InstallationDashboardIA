# =============================================================================
# Analytics Platform — configuração de ambiente
# =============================================================================
# COPIE este arquivo para `.env` e preencha. O `.env` é ignorado pelo git.
#
#   cp .env.example .env
#
# NUNCA comite o `.env`, nem cole estes valores em chat/ticket/PR.
#
# Depois de preencher, valide a conectividade com:
#   npm run doctor
# =============================================================================


# -----------------------------------------------------------------------------
# dbVoalle — PostgreSQL do ERP Voalle (fonte principal: 15 das 24 queries)
# -----------------------------------------------------------------------------
# A plataforma é SOMENTE LEITURA. Use um usuário com permissão apenas de SELECT;
# o pool ainda força `default_transaction_read_only` como segunda barreira.
VOALLE_HOST=
VOALLE_PORT=5432
VOALLE_DATABASE=
VOALLE_USER=
VOALLE_PASSWORD=
VOALLE_SCHEMA=erp
# Exige TLS na conexão (recomendado fora da rede interna): true | false
VOALLE_SSL=false
# Aceita certificado self-signed (só use se o servidor usar cert próprio)
VOALLE_SSL_REJECT_UNAUTHORIZED=true
# Tamanho do pool e timeouts (ms)
VOALLE_POOL_MAX=10
VOALLE_STATEMENT_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# dbMaria — MariaDB (3 queries do registry)
# -----------------------------------------------------------------------------
# Tabelas usadas em DB_Applicattion: Backlog_Installation, Backlog_Schedules,
# Installation_Teams.
MARIA_HOST=
MARIA_PORT=3306
MARIA_DATABASE=DB_Applicattion
MARIA_USER=
MARIA_PASSWORD=
MARIA_SSL=false
MARIA_POOL_MAX=5
MARIA_STATEMENT_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# Redis — cache de queries (container no Portainer)
# -----------------------------------------------------------------------------
# Formato: redis://[:senha@]host:porta/db  ou  rediss:// para TLS
# Deixe VAZIO/comentado se não houver Redis: o cache cai para memória e o
# `doctor` pula a checagem em vez de reportar falha.
# REDIS_URL=redis://localhost:6379/0
# Prefixo das chaves — isole ambientes (dev/hml/prod) no mesmo Redis
REDIS_KEY_PREFIX=analytics:dev:


# -----------------------------------------------------------------------------
# Kafka — eventos CDC vindos do Debezium (container no Portainer)
# -----------------------------------------------------------------------------
# Lista separada por vírgula: host1:9092,host2:9092
KAFKA_BROKERS=
KAFKA_CLIENT_ID=analytics-platform
KAFKA_GROUP_ID=analytics-realtime
# Prefixo dos tópicos que o Debezium publica para o Postgres do Voalle.
# Ex.: com prefixo "voalle", a tabela contracts vira "voalle.public.contracts"
KAFKA_TOPIC_PREFIX=voalle
# SASL (deixe em branco se o broker for aberto na rede interna)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL=false


# -----------------------------------------------------------------------------
# Google Sheets — planilha QUADRO FUNCIONAL (RH)
# -----------------------------------------------------------------------------
# Caminho para o JSON da service account. Compartilhe a planilha com o e-mail
# da service account (permissão de LEITOR).
GOOGLE_APPLICATION_CREDENTIALS=
GSHEETS_QUADRO_FUNCIONAL_ID=13aqmagy60DF_KJ5I4jucJD67qlJNOzzE1g1-sdU0Gjo


# -----------------------------------------------------------------------------
# Plataforma
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Porta do Analytics Core (Fastify) — usada a partir da Fase 3
PORT=3000
