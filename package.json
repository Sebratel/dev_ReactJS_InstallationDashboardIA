{
  "name": "analytics-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de Analytics Enterprise - migracao do Power BI (Sebratel)",
  "type": "module",
  "workspaces": [
    "tools/*",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "extract": "node tools/extractor/src/index.mjs",
    "test": "node --test tools/extractor/test/*.test.mjs tools/validate/test/*.test.ts tools/paridade/test/*.test.ts tools/cdc/test/*.test.ts tools/powerbi/test/*.test.ts tools/subir/test/*.test.ts packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "test:extractor": "node --test tools/extractor/test/*.test.mjs",
    "test:engine": "node --test packages/query-engine/test/*.test.ts",
    "test:model": "node --test packages/semantic-model/test/*.test.ts",
    "test:measures": "node --test packages/measure-engine/test/*.test.ts",
    "test:validate": "node --test tools/validate/test/*.test.ts",
    "doctor": "node tools/doctor/src/index.ts",
    "auth:google": "node tools/auth/src/google.ts",
    "validate:model": "node tools/validate/src/model.ts",
    "validate:tables": "node tools/validate/src/tables.ts",
    "validate:queries": "node tools/validate/src/index.ts",
    "run:mlayer": "node tools/mrun/src/index.ts",
    "probe:datahub": "node tools/probe/src/datahub.ts",
    "probe:gsheets": "node tools/probe/src/gsheets.ts",
    "probe:redis": "node tools/probe/src/redis.ts",
    "probe:tipos-data": "node tools/probe/src/tipos-data.ts",
    "powerbi": "node --max-old-space-size=8192 tools/powerbi/src/index.ts",
    "test:powerbi": "node --test tools/powerbi/test/*.test.ts",
    "cdc:observa": "node tools/cdc/src/index.ts",
    "cdc:slot": "node tools/cdc/src/slot.ts",
    "test:cdc": "node --test tools/cdc/test/*.test.ts",
    "snapshot": "node tools/snapshot/src/index.ts",
    "snapshot:calculadas": "node --max-old-space-size=8192 tools/snapshot/src/calculadas.ts",
    "snapshot:confere": "node tools/snapshot/src/confere.ts",
    "test:snapshot": "node --test packages/snapshot/test/*.test.ts",
    "start": "node tools/subir/src/index.ts",
    "api": "node --max-old-space-size=8192 apps/api/src/index.ts",
    "aquece": "node tools/subir/src/index.ts --so-aquece",
    "test:subir": "node --test tools/subir/test/*.test.ts",
    "test:api": "node --test apps/api/test/*.test.ts",
    "paginas": "node --max-old-space-size=8192 tools/paginas/src/index.ts",
    "paridade": "node tools/paridade/src/index.ts",
    "web": "npm run dev --workspace @analytics/web",
    "web:build": "npm run build --workspace @analytics/web"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "yaml": "^2.9.0"
  }
}
