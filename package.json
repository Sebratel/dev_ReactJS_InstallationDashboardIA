{
  "name": "analytics-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts tools/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && npm exec -w apps/web -- tsc --noEmit",
    "test:query-engine": "node --test packages/query-engine/test/*.test.ts",
    "test:semantic-model": "node --test packages/semantic-model/test/*.test.ts",
    "test:transform-engine": "node --test packages/transform-engine/test/*.test.ts",
    "test:measure-engine": "node --test packages/measure-engine/test/*.test.ts",
    "test:widget-engine": "node --test packages/widget-engine/test/*.test.ts",
    "test:web": "node --test apps/web/test/*.test.ts",
    "validate": "node tools/validate/src/index.ts",
    "validate:queries": "node tools/validate/src/index.ts",
    "validate:model": "node tools/validate/src/model.ts",
    "validate:tables": "node tools/validate/src/tables.ts",
    "doctor": "node tools/doctor/src/index.ts",
    "auth:google": "node tools/auth/src/google.ts",
    "run:mlayer": "node tools/mrun/src/index.ts",
    "test:mlayer": "node --test tools/mrun/test/*.test.ts",
    "probe:datahub": "node tools/probe/src/datahub.ts",
    "probe:gsheets": "node tools/probe/src/gsheets.ts",
    "probe:redis": "node tools/probe/src/redis.ts",
    "probe:tipos-data": "node tools/probe/src/tipos-data.ts",
    "probe:kafka": "node tools/probe/src/kafka-test.ts",
    "probe:determinismo-pg": "node --max-old-space-size=8192 tools/probe/src/determinismo.ts",
    "probe:instalador-ramo": "node tools/probe/src/instalador-ramo.ts",
    "probe:memoria-api": "node tools/probe/src/memoria-api.ts",
    "probe:prioridade-fila": "node tools/probe/src/prioridade-fila.ts",
    "probe:custo-contratos": "node tools/probe/src/custo-contratos.ts",
    "powerbi": "node --max-old-space-size=8192 tools/powerbi/src/index.ts",
    "test:powerbi": "node --test tools/powerbi/test/*.test.ts",
    "cdc:observa": "node tools/cdc/src/index.ts",
    "cdc:ingere": "node tools/cdc/src/ingestor.ts",
    "cdc:slot": "node tools/cdc/src/slot.ts",
    "test:cdc": "node --test tools/cdc/test/*.test.ts",
    "snapshot": "node tools/snapshot/src/index.ts",
    "snapshot:calculadas": "node --max-old-space-size=8192 tools/snapshot/src/calculadas.ts",
    "snapshot:confere": "node tools/snapshot/src/confere.ts",
    "snapshot:converte": "node --max-old-space-size=8192 tools/snapshot/src/converte.ts",
    "test:snapshot": "node --test packages/snapshot/test/*.test.ts",
    "refresh": "node tools/refresh/src/index.ts",
    "refresh:daemon": "node --max-old-space-size=8192 tools/refresh/src/daemon.ts",
    "test:refresh": "node --test tools/refresh/test/*.test.ts",
    "start": "node tools/subir/src/index.ts",
    "api": "node --max-old-space-size=8192 apps/api/src/index.ts --sem-login",
    "aquece": "node tools/subir/src/index.ts --so-aquece",
    "test:subir": "node --test tools/subir/test/*.test.ts",
    "test:api": "node --test apps/api/test/*.test.ts",
    "paginas": "node --max-old-space-size=8192 tools/paginas/src/index.ts",
    "paginas:shas": "node --max-old-space-size=8192 tools/paginas/src/shas.ts",
    "bench:carga": "node --max-old-space-size=8192 --expose-gc tools/bench/src/carga.ts",
    "bench:colunar": "node --max-old-space-size=8192 --expose-gc tools/bench/src/colunar.ts",
    "bench:colunar-paridade": "node --max-old-space-size=8192 tools/bench/src/colunar-paridade.ts",
    "bench:identidade-por-id": "node --max-old-space-size=8192 tools/bench/src/identidade-por-id.ts",
    "bench:leitor-coluna": "node --max-old-space-size=8192 tools/bench/src/leitor-coluna.ts",
    "bench:pagina-fases": "node --max-old-space-size=8192 tools/bench/src/pagina-fases.ts",
    "paridade": "node tools/paridade/src/index.ts",
    "layout:extrai": "node --max-old-space-size=8192 tools/layout/src/extrai.ts",
    "layout:valida": "node tools/layout/src/valida-cli.ts",
    "layout:golden": "node --max-old-space-size=8192 tools/layout/src/golden.ts",
    "tela": "node tools/tela/src/varre.ts",
    "web": "npm run dev --workspace @analytics/web",
    "web:build": "npm run build --workspace @analytics/web",
    "probe:reaquecimento": "node --max-old-space-size=3072 tools/probe/src/reaquecimento-pos-evento.ts",
    "probe:watch-snapshot": "node tools/probe/src/watch-do-snapshot.ts",
    "probe:staging": "node tools/probe/src/staging.ts",
    "probe:compara-materializacao": "node --max-old-space-size=8192 tools/probe/src/compara-materializacao.ts"
  },
  "dependencies": {
    "google-auth-library": "^11.0.2",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.34.0",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "yaml": "^2.5.0"
  }
}
