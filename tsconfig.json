{
  // Verificação de tipos do back-end (API, packages, tools). O Node executa .ts só
  // apagando as anotações — sem este arquivo nada confere tipo fora de apps/web.
  // `npm run typecheck` roda este e o de apps/web. Não emite nada.
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "packages/*/src/**/*.ts", "tools/*/src/**/*.ts"]
}
